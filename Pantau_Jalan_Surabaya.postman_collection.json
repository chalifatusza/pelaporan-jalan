				{
					"name": "Login Akun",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.data.token);",
									"    pm.environment.set(\"api_key\", jsonData.data.user.api_key);",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.data.token);",
									"    pm.collectionVariables.set(\"api_key\", jsonData.data.user.api_key);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"user\",\n    \"password\": \"user123\"\n}"
						},
